# Root ignore policy for the FarmCrossSync 25 monorepo.
# Nested projects may narrow these further; this file is the baseline that
# keeps local state, dependencies, build output, and secrets out of the tree.

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Build output -----------------------------------------------------------
dist/
build/
.svelte-kit/
*.tsbuildinfo
# Rust / Tauri build cache (can reach many GB; regenerated by `cargo build`).
target/
# Tauri generated capability schemas; regenerated by `tauri-build` from
# FarmCrossSync25-app/src-tauri/capabilities/.
FarmCrossSync25-app/src-tauri/gen/

# --- Local service state ----------------------------------------------------
# Wrangler local D1/R2 state and bundler scratch (`.wrangler/state/` holds a
# local database and bucket objects).
.wrangler/

# --- Secrets and machine-local environment ---------------------------------
.env
.env.*
!.env.example
# Wrangler local secrets (`.dev.vars`).
.dev.vars

# --- Local identity / session data -----------------------------------------
# Defensive: never let a copied local identity or sync-state store be staged.
identity.json
*-sync-state/

# --- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
