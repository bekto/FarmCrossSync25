{
  "name": "farm-crosssync25-app",
  "version": "0.1.0",
  "description": "Farm CrossSync 25 desktop client — share FS25 savegames within a multiplayer farm. Tauri 2 + SvelteKit.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "audit:styles": "node scripts/audit-styles.mjs",
    "upload:e2e": "node scripts/upload-e2e.mjs",
    "download:e2e": "node scripts/download-e2e.mjs",
    "lifecycle:e2e": "node scripts/farm-lifecycle-e2e.mjs",
    "reliability:e2e": "node scripts/reliability-e2e.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "private": true
}
