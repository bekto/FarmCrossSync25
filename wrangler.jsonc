{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farm-crosssync-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farm-crosssync-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "farm-crosssync-saves"
    }
  ]
}
